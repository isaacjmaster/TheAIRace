{
  "name": "the-ai-race",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "raid:dev": "vite --config raid/vite.config.ts",
    "raid:build": "tsc --project raid/tsconfig.json && vite build --config raid/vite.config.ts",
    "raid:preview": "vite preview --config raid/vite.config.ts",
    "raid:test": "tsx --test raid/*.test.ts",
    "dev": "concurrently -k \"node --env-file-if-exists=.env --import tsx --watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts server/*.test.ts raid/*.test.ts",
    "test:production": "node scripts/smoke-production.mjs",
    "preview:combat": "node --import tsx scripts/preview-combat.ts",
    "preview:identity": "node --import tsx scripts/preview-identity.ts",
    "preview:district": "node --import tsx scripts/preview-district.ts",
    "preview:infiltration": "node --import tsx scripts/preview-infiltration.ts",
    "preview:refinements": "node --import tsx scripts/preview-refinements.ts",
    "preview:decorations": "node --import tsx scripts/preview-decorations.ts",
    "preview:territory": "node --import tsx scripts/preview-territory.ts",
    "preview:plot": "node --import tsx scripts/preview-hq-plot.ts",
    "preview:hq": "node --import tsx scripts/preview-founder-hq.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "openai": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "0.186.1",
    "zod": "^4.0.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": "24.x"
  }
}
